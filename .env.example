# --- Postgres (compose-internal) ---
POSTGRES_USER=akademie
POSTGRES_PASSWORD=change-me
POSTGRES_DB=akademie

# --- Web app ---
# Signs the admin session cookie. Generate: openssl rand -base64 32
SESSION_SECRET=change-me

# Public base URL of the site (metadata, sitemap, JSON-LD).
SITE_URL=https://kubikraum.academy

# --- E-Mail-Versand (SMTP) für Anmelde-Bestätigungen ---
# Ohne SMTP_HOST wird jede Mail nur in die Container-Logs geschrieben. Die
# Anmeldung selbst funktioniert weiterhin — sie kommt nur ohne Bestätigung an.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=anmeldung@kubikraum.academy
SMTP_PASSWORD=change-me
SMTP_FROM=Kubikraum Akademie <anmeldung@kubikraum.academy>
# Wohin die interne Meldung "neue Anmeldung" geht. Default: SUPPORT_EMAIL.
NOTIFY_EMAIL=christian@kubikraum.digital

# --- Stripe (nur für bezahlte Events) ---
# Signing-Secret des Webhooks https://<domain>/api/stripe/webhook
# (Stripe-Dashboard → Entwickler → Webhooks). Ohne diesen Wert antwortet der
# Endpoint mit 500 und keine Zahlung wird automatisch bestätigt.
STRIPE_WEBHOOK_SECRET=whsec_change-me

# --- Videos (selbst gehostet auf dem Volume `media-data`) ---
# Muss zum Volume-Mount in docker-compose.yml passen.
MEDIA_DIR=/data/media
# Obergrenze pro Datei und für alles zusammen. Die Bremse ist wichtig: die
# Videos liegen auf derselben Platte wie Postgres — eine volle Platte legt die
# Datenbank lahm, nicht nur den nächsten Upload.
MEDIA_MAX_FILE_MB=300
MEDIA_MAX_TOTAL_MB=2000
# Eigene, viel kleinere Grenze für Bilder (Event-Thumbnails, Video-Standbilder).
MEDIA_MAX_IMAGE_MB=8

# --- Quiz evaluation (Cortecs AI, EU-hosted, OpenAI-compatible) ---
# Without the key the quiz pages render but every check answers
# "Das Quiz ist gerade nicht verfügbar." — the rest of the site is unaffected.
CORTECS_API_KEY=change-me
# Optional. Cortecs model ids are flat, without a vendor prefix.
CORTECS_MODEL=claude-haiku-4-5

# --- Initial admin (used ONCE by the seed, only while no admin exists) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# --- Local dev (npm run dev) ---
# DATABASE_URL=postgresql://akademie:akademie@localhost:5432/akademie
