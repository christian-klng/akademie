# --- Postgres (compose-internal) ---
POSTGRES_USER=akademie
POSTGRES_PASSWORD=change-me
POSTGRES_DB=akademie

# --- Web app ---
# Signs the admin session cookie. Generate: openssl rand -base64 32
SESSION_SECRET=change-me

# Public base URL of the site (metadata, sitemap, JSON-LD).
SITE_URL=https://akademie.kubikraum.digital

# --- Initial admin (used ONCE by the seed, only while no admin exists) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# --- Local dev (npm run dev) ---
